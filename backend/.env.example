# Copy this file to backend/.env; keep the copy private.
NODE_ENV=development
PORT=4000

# Configure MongoDB to persist accounts, listings, inventory, orders, and verification data.
# Development without this URI uses the explicitly-labeled, reset-on-restart demo store.
MONGODB_URI=

# Production requires a unique random key of at least 32 characters; never commit this secret.
# Development demos use a freshly generated, memory-only signing key and reset tokens on restart.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Optional real product image uploads. Keep all three values on the server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

DEMO_MODE=true
